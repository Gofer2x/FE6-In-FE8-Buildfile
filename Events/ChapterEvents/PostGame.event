#include EAstdlib.event

//Flags/EventIDs
//BossQuoteFlag 0x1
//BossDefeatFlag 0x2
//SeizeFlag 0x3
//SecondBGMFlag 0x4
// 0x5
//RoutFlag 0x6

EventPointerTable(EVENTS_PostGame,ThisChapter)
EscapePointPointerTable(CHAPTER_PostGame,0x0)
NPCEscapePointPointerTable(CHAPTER_PostGame,0x0)

ALIGN 4

ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN Dunno Dunno Dunno
POIN Tutorial
POIN TrapData EmptyTrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene

TurnBasedEvents:
END_MAIN
ALIGN 32 //For some reason, CharacterBasedEvents have to be 32-Aligned?

CharacterBasedEvents:
CharacterEvent(0x0,ReturnTalk,Roy,IdunnHuman)
CharacterEvent(0x0,ValleyOfDeathTalk,Roy,GenericBanditTrialValleyOfDeath)
CharacterEvent(0x0,RainyIslandTalk,Roy,GenericWestIslesTrialRainyIsland)
CharacterEvent(0x0,SnowyDefensiveTalk,Roy,GenericIlliaTrialSnowyDefensive)
CharacterEvent(0x0,PiratesChallengeTalk,Roy,GenericPirateTrialPiratesChallenge)
CharacterEvent(0x0,RoysTrialTalk,Roy,GenericBanditTrialRoysTrial)
END_MAIN

LocationBasedEvents:
END_MAIN

MiscBasedEvents:
CauseGameOverIfLordDies
END_MAIN

Dunno:
END_MAIN

Tutorial:
END_MAIN

TrapData:
ENDTRAP

ALIGN 4

Units:
UNIT Roy RoyLord 0x0 Level(20,Ally,1) [8,11] 0x0 0x0 0x0 0x0 [Rapier, IronSword, Vulnerary] DummyAI
UNIT

Enemies:
UNIT IdunnHuman ShamanF 0x0 Level(20,NPC,1) [8,16] 0x0 0x0 0x0 0x0 [Elixir] [AI1_InPlace, AI2_DontMove, RAI_30_80|TAI_HP, AI4_DontRetreat]
UNIT GenericBanditTrialValleyOfDeath Berserker 0x0 Level(10,NPC,1) [4,9] 0x0 0x0 0x0 0x0 [SteelAxe] [AI1_InPlace, AI2_DontMove, RAI_30_80|TAI_HP, AI4_DontRetreat]
UNIT GenericWestIslesTrialRainyIsland Mage 0x0 Level(20,NPC,1) [6,9] 0x0 0x0 0x0 0x0 [Elfire] [AI1_InPlace, AI2_DontMove, RAI_30_80|TAI_HP, AI4_DontRetreat]
UNIT GenericIlliaTrialSnowyDefensive Falcoknight 0x0 Level(15,NPC,1) [8,9] 0x0 0x0 0x0 0x0 [Axereaver] [AI1_InPlace, AI2_DontMove, RAI_30_80|TAI_HP, AI4_DontRetreat]
UNIT GenericPirateTrialPiratesChallenge Pirate 0x0 Level(15,NPC,1) [10,9] 0x0 0x0 0x0 0x0 [PoisonAxe, HandAxe] [AI1_InPlace, AI2_DontMove, RAI_30_80|TAI_HP, AI4_DontRetreat]
UNIT GenericBanditTrialRoysTrial Warrior 0x0 Level(10,NPC,1) [12,9] 0x0 0x0 0x0 0x0 [SilverAxe, SteelBow] [AI1_InPlace, AI2_DontMove, RAI_30_80|TAI_HP, AI4_DontRetreat]
UNIT

ALIGN 4

ReturnTalk:
Text(PostGame_ReturnToWorldMap)
IfNoSelectedGoto(1)
ReturnToWorldMap
LABEL 1
EndEvent

ValleyOfDeathTalk:
Text(PostGame_ValleyOfDeathDesc)
TextWindow(PostGame_StartValleyOfDeath)
IfNoSelectedGoto(1)
MoveToChapterWithoutWM(CHAPTER_TrialValleyOfDeath)
LABEL 1
EndEvent

RainyIslandTalk:
Text(PostGame_RainyIslandDesc)
TextWindow(PostGame_StartRainyIsland)
IfNoSelectedGoto(1)
MoveToChapterWithoutWM(CHAPTER_TrialRainyIsland)
LABEL 1
EndEvent

SnowyDefensiveTalk:
Text(PostGame_SnowyDefensiveDesc)
TextWindow(PostGame_StartSnowyDefensive)
IfNoSelectedGoto(1)
MoveToChapterWithoutWM(CHAPTER_TrialSnowyDefensive)
LABEL 1
EndEvent

PiratesChallengeTalk:
Text(PostGame_PiratesChallengeDesc)
TextWindow(PostGame_StartPiratesChallenge)
IfNoSelectedGoto(1)
MoveToChapterWithoutWM(CHAPTER_TrialPiratesChallenge)
