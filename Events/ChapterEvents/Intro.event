#include EAstdlib.event

//Flags/EventIDs
//BossQuoteFlag 0x1
//BossDefeatFlag 0x2
//SeizeFlag 0x3
//SecondBGMFlag 0x4
// 0x5
//RoutFlag 0x6

EventPointerTable(EVENTS_Intro,ThisChapter)
EscapePointPointerTable(CHAPTER_Intro,0x0)
NPCEscapePointPointerTable(CHAPTER_Intro,0x0)

ALIGN 4

ThisChapter:
POIN TurnBasedEvents
POIN CharacterBasedEvents
POIN LocationBasedEvents
POIN MiscBasedEvents
POIN Dunno Dunno Dunno
POIN Tutorial
POIN TrapData EmptyTrapData
POIN Units Units
POIN $0 $0 $0 $0 $0 $0
POIN BeginningScene EndingScene

TurnBasedEvents:
END_MAIN
ALIGN 32 //For some reason, CharacterBasedEvents have to be 32-Aligned?

CharacterBasedEvents:
END_MAIN

LocationBasedEvents:
END_MAIN

MiscBasedEvents:
END_MAIN

Dunno:
END_MAIN

Tutorial:
END_MAIN

TrapData:
ENDTRAP

ALIGN 4

Units:
UNIT

CuteRoyAndLilina:
UNIT Roy RoyLord 0x0 Level(1,Ally,0) [2,11] 0x0 0x0 0x0 0x0 [Rapier, Vulnerary] DummyAI
UNIT Lilina MageF 0x0 Level(1,Ally,0) [3,11] 0x0 0x0 0x0 0x0 [Fire, Vulnerary] DummyAI
UNIT

ALIGN 4

BeginningScene:
DisableSceneDialogueSkipping
LOAD2 0x1 CuteRoyAndLilina
ENUN
FadeFromBlack
PlayMusic(BGS_Envsound_Nighttime)
TextWindow(DevIntro1)
TextWindow(DevIntro2)
TextWindow(DevIntroCasualChoice)
IfNoSelectedGoto(1)
FlagON(CASUAL_MODE_FLAG)
TextWindow(DevIntroCasualON)
LABEL 1
TextWindow(DevIntroFixedGrowthsChoice)
IfNoSelectedGoto(2)
FlagON(FIXED_GROWTHS_FLAG_ID)
TextWindow(DevIntroFixedGrowthsON)
LABEL 2
EnableSceneDialogueSkipping
TextWindow(DevIntroEnd)
MoveToChapterWithoutWM(CHAPTER_Ch1)
ENDA

EndingScene:
ENDA

//MESSAGE Events end at offset CURRENTOFFSET