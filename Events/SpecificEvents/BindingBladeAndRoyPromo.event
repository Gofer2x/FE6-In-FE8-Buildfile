EVENT_BindingBladeAndRoyPromo:
FadeOutMusic
STAL 64
SetBackground(BG_Castle2)
TEXTSTART
TEXTSHOW Ch21_Ch21x_EndBindingBlade1
TEXTEND
FadeIntoWhite(16)
PlaySound(SND_MagicShine)
FadeFromWhite(16)
TEXTCONT //whoa! what's happening?
TEXTEND
PlaySound(SND_MagicShine)
FadeIntoWhite(4)
REMA
SetBackground(BG_Temple1Bright)
FadeFromWhite(4)
PlayMusic(MUS_TheDarkPriestess)
TEXTSTART
TEXTSHOW Ch21_Ch21x_EndBindingBlade2
TEXTEND
FlashWhiteAdjustable(16)


PlaySound(SND_MagicShine)
FadeIntoWhite(4)
REMA
SetBackground(BG_Castle2)
FadeFromWhite(4)
PlayMusic(MUS_MainThemeArrangement)
TEXTSTART
TEXTSHOW Ch21_Ch21x_EndBindingBlade3
TEXTEND
REMA
GiveItemToCharacter(Roy,BindingBlade)
STAL 64
HIDEMAP
PROM Roy RoyGreatLord BindingBlade
//Ugly hack but it works. Otherwise the map stays black with only units visible.
BranchIfChapterIDIs(1,CHAPTER_Ch21x)
LOMA CHAPTER_Ch21
CAM1 [24,27]
GOTO 2
LABEL 1
LOMA CHAPTER_Ch21x
CAM1 [15,1]
LABEL 2
SHOWMAP
FadeFromBlack(Fade1s)
STAL 1280
MoveToChapter(CHAPTER_Ch22)
EndEvent